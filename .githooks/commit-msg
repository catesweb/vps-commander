#!/bin/sh
# Rejects AI/tool attribution footers before the commit exists. CI runs the
# same check (.github/workflows/ci.yml), but by then the commit is already
# pushed — and a Co-Authored-By trailer registers that account as a repo
# contributor on GitHub the moment it lands. Keep this pattern in sync with
# BANNED in ci.yml. Tool names use a `.` wildcard so this file does not
# itself spell out the vendor names it bans.
BANNED='^co-authored-by:|^co-authored by:|^generated with|^generated by:|c.debuff|c.pilot|🤖'

if grep -iE "$BANNED" "$1" >/dev/null; then
  echo "commit-msg: attribution footer detected — AGENTS.md forbids adding contributors." >&2
  echo "Offending line(s):" >&2
  grep -inE "$BANNED" "$1" >&2
  exit 1
fi
